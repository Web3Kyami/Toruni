{
  "name": "toruni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json --noEmit false --outDir .toruni/server",
    "start:server": "node .toruni/server/server/index.js",
    "build": "npm run typecheck && vite build && npm run build:server",
    "test": "node --experimental-strip-types tests/scoring.test.ts && node --experimental-strip-types tests/strike.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}
