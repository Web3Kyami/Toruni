{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/arena", "destination": "/index.html" },
    { "source": "/results/:roundId", "destination": "/index.html" }
  ]
}
